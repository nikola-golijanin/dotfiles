{
    "containers.containerClient": "com.microsoft.visualstudio.containers.docker",
    "containers.orchestratorClient": "com.microsoft.visualstudio.orchestrators.dockercompose",
    "resharper.region.region": "Europe",
    "resharper.dataSharing.allowDataSharing": false,
    "workbench.list.smoothScrolling": true,
    "workbench.editor.showTabs": "multiple",
    "workbench.editor.tabSizing": "shrink",
    "workbench.colorCustomizations": {
        "editorCursor.foreground": "#FFB86C",
        "editorCursor.background": "#000000",
        "statusBar.noFolderBackground": "#8f2424",
        "statusBar.debuggingBackground": "#263238",
        "[Dark+]": {
            "editor.lineHighlightBackground": "#0f0f0f",
            "editor.lineHighlightBorder": "#0f0f0f"
        }
    },
    "workbench.editor.enablePreview": false,
    "workbench.tree.renderIndentGuides": "none",
    "workbench.tree.indent": 4,
    "workbench.modernUIFrostedGlass": true,
    "workbench.modernUIFrostedGlassOpacity": 50,
    "workbench.experimental.modernUIEditorTabStyle": "connected",
    "workbench.iconTheme": "vscode-icons",
    "workbench.colorTheme": "Dark+",
    //EDITOR
    "editor.tabSize": 4,
    "editor.fontFamily": "Cascadia Code",
    "editor.fontSize": 12,
    "editor.fontLigatures": true,
    "editor.lineHeight": 20,
    "editor.minimap.enabled": true,
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.lineNumbers": "relative",
    "editor.inlayHints.enabled": "onUnlessPressed",
    "editor.inlayHints.fontSize": 11,
    "editor.largeFileOptimizations": false,
    "editor.mouseWheelZoom": true,
    "editor.mouseWheelScrollSensitivity": 1.5,
    "editor.smoothScrolling": true,
    "editor.cursorBlinking": "solid",
    "editor.cursorStyle": "line",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.scrollbar.vertical": "visible",
    "editor.renderLineHighlight": "all",
    "editor.bracketPairColorization.enabled": true,
    "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
    "editor.guides.highlightActiveBracketPair": false,
    "editor.guides.bracketPairs": "active",
    "editor.guides.bracketPairsHorizontal": false,
    "editor.renderControlCharacters": false,
    "editor.cursorSurroundingLines": 8,
    //EXPLORER
    "explorer.compactFolders": false,
    "explorer.decorations.badges": true,
    "explorer.decorations.colors": true,
    "explorer.fileNesting.enabled": true,
    //FILES
    "files.autoSave": "afterDelay",
    "files.autoSaveWhenNoErrors": true,
    "files.insertFinalNewline": true,
    //BREADCRUMBS
    "breadcrumbs.enabled": true,
    "breadcrumbs.filePath": "on",
    "breadcrumbs.symbolPath": "on",
    //DEBUG
    "debug.showVariableTypes": true,
    "debug.console.fontSize": 12,
    //PROBLEMS
    "problems.autoReveal": true,
    "problems.decorations.enabled": true,
    //TERMINAL
    "terminal.integrated.fontFamily": "Cascadia Mono",
    "terminal.integrated.fontSize": 15,
    //C#
    "[csharp]": {
        "editor.rulers": [
            {
                "column": 120,
                "color": "#80808080"
            }
        ]
    },
    //GO
    "gopls": {
        "ui.semanticTokens": true,
        "formatting.gofumpt": true
    },
    "[go]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "golang.go"
    },
    "go.inlayHints.parameterNames": true,
    "go.toolsManagement.autoUpdate": true,
    //GIT
    "git.allowForcePush": true,
    "git.blame.statusBarItem.template": "${authorName} (${authorDateAgo}) - ${subject}",
    "git.closeDiffOnOperation": true,
    "git.replaceTagsWhenPull": true,
    "git.autofetch": true,
    "diffEditor.ignoreTrimWhitespace": true,
    //REMOTE
    "remote.SSH.remotePlatform": {
        "192.168.0.12": "linux",
        "srv05.sowadev.com": "linux"
    },
    //VIM
    "vim.useSystemClipboard": true,
    "vim.timeout": 400,
    "vim.easymotion": true,
    "vim.leader": "<space>",
    "vim.useCtrlKeys": true,
    "vim.handleKeys": {
        "<Tab>": false
    },
    "vim.normalModeKeyBindings": [
        {
            "before": [
                "<C-p>"
            ],
            "commands": [
                "workbench.action.quickOpen"
            ]
        },
        {
            "before": [
                "<leader>",
                "e"
            ],
            "commands": [
                "workbench.files.action.focusOpenEditorsView"
            ]
        },
        {
            "before": [
                "<leader>",
                "g",
                "d"
            ],
            "commands": [
                "editor.action.revealDefinition"
            ]
        },
        {
            "before": [
                "<leader>",
                "g",
                "i"
            ],
            "commands": [
                "editor.action.goToImplementation"
            ]
        },
        {
            "before": [
                "<leader>",
                "g",
                "r"
            ],
            "commands": [
                "editor.action.goToReferences"
            ]
        },
        {
            "before": [
                "<leader>",
                "g",
                "b"
            ],
            "commands": [
                "workbench.action.navigateBack"
            ]
        },
        {
            "before": [
                "<leader>",
                "g",
                "f"
            ],
            "commands": [
                "workbench.action.navigateForward"
            ]
        },
        {
            "before": [
                "<leader>",
                "z",
                "m"
            ],
            "commands": [
                "workbench.action.toggleZenMode"
            ]
        },
        {
            "before": [
                "<leader>",
                "c",
                "f"
            ],
            "commands": [
                "editor.action.formatDocument"
            ]
        },
        {
            "before": [
                "<leader>",
                "g",
                "r"
            ],
            "commands": [
                "editor.action.referenceSearch.trigger"
            ]
        },
        {
            "before": [
                "<leader>",
                "c",
                "a"
            ],
            "commands": [
                "editor.action.quickFix"
            ]
        },
        {
            "before": [
                "<leader>",
                "c",
                "r"
            ],
            "commands": [
                "editor.action.refactor"
            ]
        },
        {
            "before": [
                "<leader>",
                "c",
                "c"
            ],
            "commands": [
                "editor.action.commentLine"
            ]
        },
        {
            "before": [
                "<leader>",
                "c",
                "s"
            ],
            "commands": [
                "editor.action.organizeImports"
            ]
        },
        {
            "before": [
                "<leader>",
                "s",
                "e"
            ],
            "commands": [
                "solutionExplorer.focus"
            ]
        },
        {
            "before": [
                "<leader>",
                "f",
                "e"
            ],
            "commands": [
                "workbench.explorer.fileView.focus"
            ]
        },
        {
            "before": [
                "<leader>",
                "o",
                "r"
            ],
            "commands": [
                "workbench.action.openRecent"
            ]
        },
        {
            "before": [
                "<leader>",
                "f",
                "o"
            ],
            "commands": [
                "workbench.action.gotoSymbol"
            ]
        },
        {
            "before": [
                "<leader>",
                "o"
            ],
            "commands": [
                "outline.focus"
            ]
        },
        {
            "before": [
                "<leader>",
                "s",
                "s"
            ],
            "commands": [
                "actions.find"
            ]
        },
        {
            "before": [
                "<leader>",
                "s",
                "f"
            ],
            "commands": [
                "search.action.openNewEditorToSide"
            ]
        },
        {
            "before": [
                "<leader>",
                "s",
                "r"
            ],
            "commands": [
                "workbench.action.replaceInFiles"
            ]
        },
        {
            "before": [
                "<leader>",
                "f",
                "r"
            ],
            "commands": [
                "references-view.findReferences"
            ]
        },
        {
            "before": [
                "<leader>",
                "d",
                "t"
            ],
            "commands": [
                "dotnet.views.toggleBetweenCodeAndRazorView"
            ]
        },
        {
            "before": [
                "<leader>",
                "d",
                "d"
            ],
            "commands": [
                "workbench.action.debug.start"
            ]
        },
        {
            "before": [
                "<leader>",
                "d",
                "r"
            ],
            "commands": [
                "workbench.action.debug.run"
            ]
        },
        {
            "before": [
                "<leader>",
                "b"
            ],
            "commands": [
                "editor.debug.action.toggleBreakpoint"
            ]
        },
        {
            "before": [
                "<leader>",
                "g",
                "s"
            ],
            "commands": [
                "workbench.view.scm"
            ]
        },
        {
            "before": [
                "<leader>",
                "g",
                "p"
            ],
            "commands": [
                "git.pull"
            ]
        },
        {
            "before": [
                "<leader>",
                "s",
                "c"
            ],
            "commands": [
                "git.stashIncludeUntracked"
            ]
        },
        {
            "before": [
                "<leader>",
                "r",
                "s"
            ],
            "commands": [
                "git.revertSelectedRanges"
            ]
        },
        {
            "before": [
                "<leader>",
                "v",
                "s"
            ],
            "commands": [
                "git.stashView"
            ]
        },
        {
            "before": [
                "<leader>",
                "a",
                "s"
            ],
            "commands": [
                "git.stashApply"
            ]
        },
        {
            "before": [
                "<leader>",
                "c",
                "o"
            ],
            "commands": [
                "git.checkout"
            ]
        },
        {
            "before": [
                "<leader>",
                "p",
                "e"
            ],
            "commands": [
                "workbench.action.pinEditor"
            ]
        },
        {
            "before": [
                "<leader>",
                "u",
                "e"
            ],
            "commands": [
                "workbench.action.unpinEditor"
            ]
        },
        {
            "before": [
                "<leader>",
                "t",
                "n"
            ],
            "commands": [
                "workbench.action.nextEditor"
            ]
        },
        {
            "before": [
                "<leader>",
                "t",
                "p"
            ],
            "commands": [
                "workbench.action.previousEditor"
            ]
        },
        {
            "before": [
                "<leader>",
                "t",
                "c"
            ],
            "commands": [
                "workbench.action.closeActiveEditor"
            ]
        },
        {
            "before": [
                "<leader>",
                "g",
                "c"
            ],
            "commands": [
                "workbench.panel.chat"
            ]
        },
        {
            "before": [
                "<leader>",
                "1"
            ],
            "commands": [
                "workbench.action.focusFirstEditorGroup"
            ]
        },
        {
            "before": [
                "<leader>",
                "2"
            ],
            "commands": [
                "workbench.action.focusSecondEditorGroup"
            ]
        },
        {
            "before": [
                "<leader>",
                "n",
                "w"
            ],
            "commands": [
                "workbench.action.moveEditorToNewWindow"
            ]
        },
        {
            "before": [
                "<leader>",
                "3"
            ],
            "commands": [
                "workbench.action.focusThirdEditorGroup"
            ]
        },
        {
            "before": [
                "<leader>",
                "h"
            ],
            "commands": [
                "workbench.action.moveEditorToLeftGroup"
            ]
        },
        {
            "before": [
                "<leader>",
                "l"
            ],
            "commands": [
                "workbench.action.moveEditorToRightGroup"
            ]
        },
        {
            "before": [
                "<leader>",
                "j"
            ],
            "commands": [
                "workbench.action.moveEditorToBelowGroup"
            ]
        },
        {
            "before": [
                "<leader>",
                "k"
            ],
            "commands": [
                "workbench.action.moveEditorToAboveGroup"
            ]
        },
        {
            "before": [
                "<leader>",
                "n",
                "g"
            ],
            "commands": [
                "workbench.action.moveEditorToNextGroup"
            ]
        },
        {
            "before": [
                "<leader>",
                "p",
                "g"
            ],
            "commands": [
                "workbench.action.moveEditorToPreviousGroup"
            ]
        },
        {
            "before": [
                "<leader>",
                "t",
                "e"
            ],
            "commands": [
                "workbench.action.createTerminalEditor"
            ]
        }
    ],
    //ZEN MODE
    "zenMode.centerLayout": false,
    "zenMode.hideActivityBar": false,
    "zenMode.hideLineNumbers": false,
    "security.promptForLocalFileProtocolHandling": false,
    //COPILOT
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": false,
        "scminput": false,
        "go": true
    }
}
